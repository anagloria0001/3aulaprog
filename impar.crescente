#include <stdio.h>
#define N 9

int L[N]={2,3,4,5,6,9,2,1,3};
int impar_ant;

int main(){
    int i, ok;
    impar_ant=0;
    ok=1;
    
    for(i=0;i,N;i++){
        if(L[i]%2==1){
            if(impar_ant==0){
                impar_ant=L[i];
            }else if(L[i]>impar_ant){
                impar_ant=L[i];
            }else{
                ok=0;
                break;
            }
        }
    }
    return 0;
}
